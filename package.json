{
  "name": "nemu",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @nemu/desktop dev",
    "dev:stage": "pnpm --filter @nemu/stage dev",
    "dev:panel": "pnpm --filter @nemu/panel dev",
    "dev:review": "pnpm --filter @nemu/stage dev:review",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "pnpm -r build",
    "test:e2e": "pnpm build && playwright test --config apps/desktop/playwright.config.ts",
    "test:panel:e2e": "pnpm build && playwright test --config apps/panel/src/debug/playwright.config.ts",
    "test:visual": "node apps/stage/tests/visual/runner.mjs",
    "test:edge": "node apps/stage/tests/visual/edge-check.mjs",
    "bench": "node tools/scaffold/pending.mjs P7-01",
    "asset:build": "node tools/asset-pipeline/launch.mjs build",
    "asset:step": "node tools/asset-pipeline/launch.mjs step",
    "asset:lint": "node tools/asset-lint/launch.mjs",
    "accept:core": "node tools/scaffold/pending.mjs P5-18",
    "eval:helpers": "node tools/scaffold/pending.mjs P6-06",
    "eval:speech": "node tools/scaffold/pending.mjs P4-06",
    "eval:memory": "node tools/scaffold/pending.mjs P6-03",
    "format:check": "prettier --check .",
    "test:transport": "node --test tools/scaffold/transport.test.mjs",
    "ci:budget": "node tools/scaffold/ci-budget.mjs",
    "test:contracts": "vitest run --config packages/contracts/vitest.config.ts --coverage",
    "test:core-contracts": "python core/contracts/verify.py",
    "board": "python tools/status/serve_board.py",
    "probe:supplement": "python workers/model-adapter/probe/run_supplement.py",
    "probe:chat": "node workers/model-adapter/probe/launch_chat.mjs",
    "asr:models": "tsx packages/voice/src/asr/models.ts download",
    "asr:public": "tsx packages/voice/src/asr/public-data.ts",
    "eval:asr": "tsx packages/voice/src/asr/evaluate.ts",
    "measure:asr": "tsx packages/voice/src/asr/measure.ts",
    "asr:user": "tsx packages/voice/src/asr/user-data.ts",
    "asr:latency": "tsx packages/voice/src/asr/latency.ts",
    "asr:align": "tsx packages/voice/src/asr/alignment.ts",
    "asr:align:models": "tsx packages/voice/src/asr/alignment.ts download",
    "asr:annotate": "tsx packages/voice/src/asr/manual.ts prepare",
    "asr:annotations": "tsx packages/voice/src/asr/manual.ts import",
    "probe:p0-08": "node spikes/codex-app-server/src/probe.mjs",
    "probe:p0-08:local": "uv run --project spikes/codex-app-server python spikes/codex-app-server/src/local_irl.py",
    "probe:p0-08:analyze": "node spikes/codex-app-server/src/analyze.mjs",
    "probe:p0-08:compare": "node spikes/codex-app-server/src/compare-remote.mjs",
    "probe:p0-08:timing": "uv run --project spikes/codex-app-server python spikes/codex-app-server/src/local_breakdown.py",
    "probe:p0-08:timing-summary": "node spikes/codex-app-server/src/summarize-local-breakdown.mjs",
    "probe:p0-08:resource-audit": "node spikes/codex-app-server/src/resource-surface-audit.mjs",
    "eval:asr:annotations": "tsx packages/voice/src/asr/manual.ts rescore",
    "test:p205:metrics": "node --test apps/stage/test/jitter/settling-metrics.test.mjs",
    "test:desktop-sense": "vitest run packages/desktop-sense/src apps/desktop/src/sense",
    "sense:geometry": "tsx packages/desktop-sense/test/native-acceptance.ts",
    "sense:cpu:build": "node packages/desktop-sense/test/build-cpu.mjs",
    "test:p306:visual": "node apps/stage/src/review/visual-regression.mjs",
    "test:p306:preview": "node apps/stage/src/review/accept-readout.mjs",
    "record:p306": "node apps/stage/src/review/accept-readout.mjs --videos"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.4",
    "ajv": "8.20.0",
    "electron": "44.7.0",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  }
}
