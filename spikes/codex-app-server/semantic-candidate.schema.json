{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemu.invalid/p0-08/semantic-candidate.schema.json",
  "title": "P0-08 SemanticCandidate measurement schema (experimental)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceRef", "nodes"],
  "properties": {
    "schemaVersion": { "const": "p0-08-candidate-v1" },
    "sourceRef": { "type": "string", "pattern": "^p0-08-[0-9]{4}$" },
    "nodes": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/refCandidate" },
          { "$ref": "#/$defs/claimCandidate" },
          { "$ref": "#/$defs/actCandidate" }
        ]
      }
    }
  },
  "$defs": {
    "sourceMetadata": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "sourceSpan": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }]
        },
        "derivation": { "enum": ["verbatim", "normalized", "resolved", "inferred"] },
        "epistemicType": { "enum": ["user_assertion", "user_self_report", "quotation", "tool_output", "system_record", "model_inference", "unknown"] },
        "resolutionState": { "enum": ["resolved", "unresolved", "provisional"] },
        "representationVersion": { "const": "p0-08-candidate-v1" }
      },
      "required": ["id", "sourceRefs", "sourceSpan", "derivation", "epistemicType", "resolutionState", "representationVersion"]
    },
    "refCandidate": {
      "allOf": [
        { "$ref": "#/$defs/sourceMetadata" },
        { "type": "object", "properties": { "kind": { "const": "Ref" }, "mention": { "type": "string", "minLength": 1 } }, "required": ["kind", "mention"] }
      ],
      "unevaluatedProperties": false
    },
    "claimCandidate": {
      "allOf": [
        { "$ref": "#/$defs/sourceMetadata" },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "Claim" },
            "predicateLabel": { "type": "string", "minLength": 1 },
            "roles": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["role", "value"], "properties": { "role": { "type": "string" }, "value": { "type": "string" } } } },
            "value": { "type": ["string", "number", "boolean", "null"] },
            "polarity": { "enum": ["positive", "negative"] },
            "modality": { "enum": ["asserted", "possible", "conditional", "desired", "reported", "unknown"] },
            "time": { "type": ["string", "null"] }
          },
          "required": ["kind", "predicateLabel", "roles", "value", "polarity", "modality", "time"]
        }
      ],
      "unevaluatedProperties": false
    },
    "actCandidate": {
      "allOf": [
        { "$ref": "#/$defs/sourceMetadata" },
        { "type": "object", "properties": { "kind": { "const": "Act" }, "actType": { "enum": ["request", "question", "correction", "commitment", "quotation", "other"] }, "content": { "type": "string" } }, "required": ["kind", "actType", "content"] }
      ],
      "unevaluatedProperties": false
    }
  }
}
