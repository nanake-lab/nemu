            "inferred"
          ]
        },
        "epistemicType": {
          "enum": [
            "user_assertion",
            "user_self_report",
            "quotation",
            "tool_output",
            "system_record",
            "model_inference",
            "unknown"
          ]
        },
        "resolutionState": {
          "enum": [
            "resolved",
            "unresolved",
            "provisional"
          ]
        },
        "representationVersion": {
          "const": "p0-08-candidate-v1"
        },
        "kind": {
          "const": "Act"
        },
        "actType": {
          "enum": [
            "request",
            "question",
            "correction",
            "commitment",
            "quotation",
            "other"
          ]
        },
        "content": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceRefs",
        "sourceSpan",
        "derivation",
        "epistemicType",
        "resolutionState",
        "representationVersion",
        "kind",
        "actType",
        "content"
      ]
    }
  }
}
