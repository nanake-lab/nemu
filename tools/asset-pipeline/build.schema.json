{
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "license": {
          "type": "string",
          "minLength": 1
        },
        "redistributable": {
          "type": "boolean"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "license",
        "redistributable"
      ],
      "additionalProperties": false
    },
    "sourceChecks": {
      "type": "object",
      "properties": {
        "bones": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "expressions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "bones",
        "expressions",
        "materials"
      ],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "const": "Nemu"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "contentLicenseUrl": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version",
        "authors",
        "contentLicenseUrl"
      ],
      "additionalProperties": false
    },
    "tail": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "objectName": {
          "type": "string",
          "minLength": 1
        },
        "bonePrefix": {
          "type": "string",
          "minLength": 1
        },
        "boneCount": {
          "type": "integer",
          "minimum": 8
        },
        "parentBone": {
          "type": "string",
          "minLength": 1
        },
        "offsetM": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "lengthM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "curve": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "minItems": 2
        },
        "radiusCurve": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0
            },
            "minItems": 2,
            "maxItems": 2
          },
          "minItems": 2
        },
        "resolution": {
          "type": "integer",
          "minimum": 1
        },
        "sectionResolution": {
          "type": "integer",
          "minimum": 0
        },
        "capEnds": {
          "type": "boolean"
        },
        "tipShape": {
          "enum": [
            "flat",
            "taper"
          ]
        },
        "tipRadiusM": {
          "type": "number",
          "minimum": 0
        },
        "hairMaterial": {
          "type": "string",
          "minLength": 1
        },
        "materialName": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "minItems": 4,
          "maxItems": 4
        }
      },
      "required": [
        "enabled",
        "objectName",
        "bonePrefix",
        "boneCount",
        "parentBone",
        "offsetM",
        "lengthM",
        "curve",
        "radiusCurve",
        "resolution",
        "sectionResolution",
        "capEnds",
        "tipShape",
        "tipRadiusM",
        "hairMaterial",
        "materialName",
        "color"
      ],
      "additionalProperties": false
    },
    "springs": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "append",
            "replace"
          ]
        },
        "attachToExisting": {
          "type": "boolean"
        },
        "groupName": {
          "type": "string",
          "minLength": 1
        },
        "colliders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "bone": {
                "type": "string",
                "minLength": 1
              },
              "shape": {
                "enum": [
                  "sphere",
                  "capsule"
                ]
              },
              "offsetM": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "radiusM": {
                "type": "number",
                "minimum": 0
              },
              "tailM": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "bone",
              "shape",
              "offsetM",
              "radiusM"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "shape": {
                      "const": "capsule"
                    }
                  }
                },
                "then": {
                  "required": [
                    "tailM"
                  ]
                }
              }
            ]
          },
          "minItems": 0
        },
        "chains": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "bones": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "centerBone": {
                "type": "string",
                "minLength": 1
              },
              "hitRadiusM": {
                "type": "number",
                "minimum": 0
              },
              "stiffness": {
                "type": "number",
                "minimum": 0
              },
              "gravityPower": {
                "type": "number",
                "minimum": 0
              },
              "gravityDir": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "dragForce": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "name",
              "bones",
              "centerBone",
              "hitRadiusM",
              "stiffness",
              "gravityPower",
              "gravityDir",
              "dragForce"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        }
      },
      "required": [
        "mode",
        "attachToExisting",
        "groupName",
        "colliders",
        "chains"
      ],
      "additionalProperties": false
    },
    "expressions": {
      "type": "object",
      "properties": {
        "preset": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "overrideMouth": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "overrideBlink": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "overrideLookAt": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "isBinary": {
                "type": "boolean"
              }
            },
            "required": [
              "overrideMouth",
              "overrideBlink",
              "overrideLookAt",
              "isBinary"
            ],
            "additionalProperties": false
          }
        },
        "custom": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "overrideMouth": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "overrideBlink": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "overrideLookAt": {
                "enum": [
                  "none",
                  "blend",
                  "block"
                ]
              },
              "isBinary": {
                "type": "boolean"
              },
              "morphs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "object": {
                      "type": "string",
                      "minLength": 1
                    },
                    "key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "weight": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "object",
                    "key",
                    "weight"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "colors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "material": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "enum": [
                        "color",
                        "emissionColor",
                        "shadeColor",
                        "matcapColor",
                        "rimColor",
                        "outlineColor"
                      ]
                    },
                    "target": {
                      "type": "array",
                      "items": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      },
                      "minItems": 4,
                      "maxItems": 4
                    }
                  },
                  "required": [
                    "material",
                    "type",
                    "target"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              },
              "transforms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "material": {
                      "type": "string",
                      "minLength": 1
                    },
                    "scale": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "offset": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    }
                  },
                  "required": [
                    "material",
                    "scale",
                    "offset"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0
              }
            },
            "required": [
              "overrideMouth",
              "overrideBlink",
              "overrideLookAt",
              "isBinary",
              "morphs",
              "colors",
              "transforms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "preset",
        "custom"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "baseColor": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "minItems": 4,
            "maxItems": 4
          },
          "mtoon": {
            "type": "object",
            "properties": {
              "shading_shift_factor": {
                "type": "number"
              },
              "shading_toony_factor": {
                "type": "number"
              },
              "gi_equalization_factor": {
                "type": "number"
              },
              "rim_lighting_mix_factor": {
                "type": "number"
              },
              "parametric_rim_fresnel_power_factor": {
                "type": "number"
              },
              "parametric_rim_lift_factor": {
                "type": "number"
              },
              "outline_width_factor": {
                "type": "number"
              },
              "outline_lighting_mix_factor": {
                "type": "number"
              },
              "shade_color_factor": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "parametric_rim_color_factor": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "outline_color_factor": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "minItems": 3,
                "maxItems": 3
              },
              "outline_width_mode": {
                "enum": [
                  "none",
                  "worldCoordinates",
                  "screenCoordinates"
                ]
              }
            },
            "required": [
              "shading_shift_factor",
              "shading_toony_factor",
              "gi_equalization_factor",
              "rim_lighting_mix_factor",
              "parametric_rim_fresnel_power_factor",
              "parametric_rim_lift_factor",
              "outline_width_factor",
              "outline_lighting_mix_factor",
              "shade_color_factor",
              "parametric_rim_color_factor",
              "outline_color_factor",
              "outline_width_mode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "baseColor",
          "mtoon"
        ],
        "additionalProperties": false
      }
    },
    "textures": {
      "type": "object",
      "properties": {
        "maxSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2048
        }
      },
      "required": [
        "maxSize"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "description": "Configuration fields of CONTRACTS 1.6. Validated using @nemu/contracts before Blender. Measurements and tailBones are generated.",
      "required": [
        "hitRegions",
        "gazeLimits",
        "framing",
        "rig",
        "emotionMap",
        "visemeMap",
        "lipSyncProfiles",
        "idleSet"
      ],
      "properties": {
        "hitRegions": {},
        "gazeLimits": {},
        "framing": {},
        "rig": {},
        "emotionMap": {},
        "visemeMap": {},
        "lipSyncProfiles": {},
        "idleSet": {}
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "source",
    "provenance",
    "sourceChecks",
    "meta",
    "tail",
    "springs",
    "expressions",
    "materials",
    "textures",
    "profile"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nemu.local/asset-pipeline/build.schema.json",
  "title": "P2-03 explicit build parameters"
}
