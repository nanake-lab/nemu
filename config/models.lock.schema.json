{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model lock scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "codex"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version"
      ],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "p0_07_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "status",
        "models"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "const": "candidates-only"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "revision",
              "role",
              "license",
              "redistributable",
              "source"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "redistributable": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "pattern": "^https://huggingface[.]co/"
              },
              "carrier_config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "layer_index_zero_based",
                  "rank",
                  "hook",
                  "precision",
                  "compute_dtype",
                  "attention",
                  "double_quantization",
                  "kernel_name",
                  "kernel_api",
                  "kernel_wrapper",
                  "torch_version",
                  "transformers_version",
                  "bitsandbytes_version",
                  "zero_modulation_reference",
                  "cross_kernel_reference",
                  "cross_kernel_logits_max_abs",
                  "cross_kernel_argmax_changes",
                  "cross_kernel_positions",
                  "cross_kernel_evidence",
                  "kernel_change_policy"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "layer_index_zero_based": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "rank": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "hook": {
                    "type": "string",
                    "minLength": 1
                  },
                  "precision": {
                    "type": "string",
                    "minLength": 1
                  },
                  "compute_dtype": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attention": {
                    "type": "string",
                    "minLength": 1
                  },
                  "double_quantization": {
                    "type": "boolean"
                  },
                  "kernel_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kernel_api": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kernel_wrapper": {
                    "type": "string",
                    "minLength": 1
                  },
                  "torch_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "transformers_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bitsandbytes_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "zero_modulation_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cross_kernel_reference": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cross_kernel_logits_max_abs": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "zh",
                      "en",
                      "ja"
                    ],
                    "properties": {
                      "zh": {
                        "type": "number",
                        "minimum": 0
                      },
                      "en": {
                        "type": "number",
                        "minimum": 0
                      },
                      "ja": {
                        "type": "number",
                        "minimum": 0
                      }
                    }
                  },
                  "cross_kernel_argmax_changes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cross_kernel_positions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cross_kernel_evidence": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kernel_change_policy": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
