{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model lock scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": ["codex"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    }
  }
}
