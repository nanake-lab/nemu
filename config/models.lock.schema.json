{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model lock scaffold",
  "type": "object",
  "additionalProperties": false,
  "required": ["codex"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "codex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "p0_07_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "status", "models"],
      "properties": {
        "version": {
          "const": 1
        },
        "status": {
          "const": "candidates-only"
        },
        "models": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "revision", "role", "license", "redistributable", "source"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              },
              "redistributable": {
                "type": "boolean"
              },
              "source": {
                "type": "string",
                "pattern": "^https://huggingface[.]co/"
              }
            }
          }
        }
      }
    }
  }
}
